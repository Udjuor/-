{
  "name": "student-calendar",
  "productName": "Horatus",
  "version": "1.17.0",
  "description": "Расписание, посещаемость и документы колледжа в одной программе",
  "author": "Udjuor",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "ru.udjuor.studentcalendar",
    "executableName": "StudentCalendar",
    "artifactName": "StudentCalendar-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "publish": [{ "provider": "github", "owner": "Udjuor", "repo": "-" }]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Horatus",
      "installerLanguages": ["ru_RU"],
      "language": "1049",
      "include": "build/installer.nsh"
    }
  }
}
